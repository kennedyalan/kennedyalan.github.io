---
import { Image } from "astro:assets";
import GitHub from "./icons/GitHub.astro";
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";
import { TAGS } from "./tags/Tags.ts";
import nexaImg from "../../public/projects/nexa.png";
import temploImg from "../../public/projects/templo.png";
import brainscriptorImg from "../../public/projects/brainscriptor.png";
import dumasImg from "../../public/projects/dumas.png";
import tempoImg from "../../public/projects/tempo.png";
import ecommerceImg from "../../public/projects/Ecommerce-API.jpg";

const en = Astro.currentLocale === "en";
const PROJECTS = [
  {
    title: en ? "Nexa - AI-powered analytics" : "Nexa - Analytics potenciado por IA",
    description: en
      ? "Analytics platform for non-technical business owners. Connect your database or spreadsheets, ask questions in plain language, and the AI builds dashboards automatically and diagnoses issues like underperforming products, trends and seasonality."
      : "Plataforma de analytics para dueños de negocio sin perfil técnico. Conectás tu base de datos o tus planillas, preguntás en lenguaje natural y la IA genera dashboards automáticos y diagnostica problemas como productos con bajo rendimiento, tendencias y estacionalidad.",
    image: nexaImg,
    tags: [TAGS.NEXT, TAGS.REACT, TAGS.TYPESCRIPT, TAGS.TAILWIND, TAGS.POSTGRESQL, TAGS.PRISMA],
  },
  {
    title: en ? "El Templo del Fútbol 5 - Field booking system" : "El Templo del Fútbol 5 - Sistema de reserva de canchas",
    description: en
      ? "Web platform for booking 5-a-side soccer fields online at a sports complex in Corrientes, Argentina. Users pick the date, time and length of their booking, with confirmation via WhatsApp."
      : "Plataforma web para la reserva online de canchas de fútbol 5 en un complejo deportivo de Corrientes, Argentina. Permite seleccionar fechas, horarios y duración de la reserva, con confirmación vía WhatsApp.",
    link: "https://eltemplodelfutbol5.com",
    image: temploImg,
    tags: [TAGS.NEXT, TAGS.REACT, TAGS.TYPESCRIPT, TAGS.TAILWIND, TAGS.POSTGRESQL, TAGS.PRISMA],
  },
  {
    title: en ? "Brainscriptor - Psychiatric medication platform" : "Brainscriptor - Plataforma digital psicofármacos",
    description: en
      ? "Digital platform that assists with personalized prescribing of psychiatric medication. I worked alongside a team of 3 developers, 1 product designer and 1 project manager. Currently seeking funding."
      : "Plataforma digital para la asistencia de prescripción personalizada de psicofármacos. Trabajé conjunto a un equipo de 3 desarrolladores, 1 product designer y 1 project manager. Actualmente en busca de financiación.",
    link: "https://app.brainscriptor.com/",
    image: brainscriptorImg,
    tags: [TAGS.NEXT, TAGS.REACT, TAGS.HTML, TAGS.CSS, TAGS.JAVASCRIPT],
  },
  {
    title: en ? "Dumas Distribuciones - Online store for a distributor" : "Dumas Distribuciones - Tienda Web para distribuidora",
    description: en
      ? "End-to-end solution for a company that distributes veterinary products. Integrated with Mercado Pago for payments and Firebase for image storage. Built as a team."
      : "Solución integral para una empresa de distribución de productos para veterinarias. Integración con Mercado Pago y Firebase para almacenamiento de imágenes. Trabajo en equipo.",
    link: "https://dumasdistribuciones.com.ar",
    image: dumasImg,
    tags: [TAGS.NEXT, TAGS.REACT, TAGS.TYPESCRIPT, TAGS.TAILWIND, TAGS.POSTGRESQL, TAGS.FIREBASE],
  },
  {
    title: en ? "TEMPO Atelier - Landing page and appointment booking" : "TEMPO Atelier - Landing y Reserva de turnos",
    description: en
      ? "Online booking system for a unisex hair salon in Corrientes, Argentina. Step-by-step booking (service, stylist, date and time) with real-time availability, plus an admin panel to manage stylists, services, schedules and appointments."
      : "Sistema de reservas online para una peluquería unisex de Corrientes, Argentina. Reserva en pasos (servicio, estilista, fecha y horario) con disponibilidad en tiempo real y panel de administración para gestionar estilistas, servicios, horarios y turnos.",
    link: "https://tempo-atelier.com",
    image: tempoImg,
    tags: [TAGS.NEXT, TAGS.REACT, TAGS.TYPESCRIPT, TAGS.TAILWIND, TAGS.POSTGRESQL, TAGS.PRISMA],
  },
  {
    title: en ? "E-commerce API - Globant Bootcamp final project" : "E-commerce API - Proyecto final de Bootcamp Globant",
    description: en
      ? "E-commerce API for managing products, carts and customers. Built with the \"decorator\" and \"factory\" design patterns and an MVC architecture. I learned a lot about best practices and REST API design."
      : "E-commerce API diseñado para administrar productos, carritos y clientes. Implementado con los patrones de diseño \"decorator\" y \"factory\" y arquitectura MVC. Aprendí mucho sobre buenas practicas y diseño de API REST.",
    github: "https://github.com/kennedyalan/Ecommerce",
    image: ecommerceImg,
    tags: [TAGS.JAVA, TAGS.SPRING, TAGS.DOCKER, TAGS.RABBITMQ],
  },
];
---

<div class="flex flex-col divide-y divide-gray-200/70 dark:divide-gray-800/70">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }, index) => {
      const sep = title.indexOf(" - ");
      const name = sep > -1 ? title.slice(0, sep) : title;
      const category = sep > -1 ? title.slice(sep + 3) : "";
      return (
        <article class="group py-12 first:pt-0 last:pb-0">

          <div class="flex items-center gap-3 mb-6">
            <span class="font-display text-xs font-bold tracking-[0.2em] text-yellow-500 dark:text-yellow-400 tabular-nums">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div class="h-px flex-1 bg-gray-300/60 dark:bg-gray-700/60" />
            {category && (
              <span class="text-[0.65rem] tracking-[0.18em] uppercase text-gray-500 dark:text-gray-500 font-medium">
                {category}
              </span>
            )}
          </div>

          <div
            class="relative overflow-hidden rounded-2xl w-full mb-7 shadow-md transition-shadow duration-500 group-hover:shadow-xl ring-1 ring-gray-200/80 dark:ring-gray-800/80"
            style="aspect-ratio: 16/7;"
          >
            <Image
              src={image}
              alt={`${en ? "Screenshot of" : "Captura de pantalla de"} ${name}`}
              class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.02]"
            />
            {link && (
              <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                class="absolute top-3 right-3 size-8 rounded-full bg-black/40 backdrop-blur-sm flex items-center justify-center text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300 hover:bg-yellow-500"
                aria-label={`${en ? "Open" : "Abrir"} ${name}`}
              >
                <Link class="size-3.5" />
              </a>
            )}
          </div>

          <div class="grid md:grid-cols-[1fr_auto] gap-x-12 gap-y-6 items-start">
            <div class="flex flex-col gap-3">
              <h3 class="font-display text-2xl md:text-[1.85rem] font-bold text-gray-900 dark:text-white leading-tight tracking-tight">
                {name}
              </h3>
              <p class="text-gray-600 dark:text-gray-400 leading-relaxed text-[0.925rem] max-w-2xl">
                {description}
              </p>
            </div>

            <div class="flex flex-col gap-4 md:items-end md:min-w-[190px]">
              <ul class="flex flex-wrap gap-2 md:justify-end">
                {tags.map((tag) => (
                  <li>
                    <span
                      class={`flex items-center gap-1.5 text-xs ${tag.class} py-1 px-2.5 rounded-full font-medium`}
                    >
                      <tag.icon class="size-3.5" />
                      {tag.name}
                    </span>
                  </li>
                ))}
              </ul>
              <div class="flex gap-2 flex-wrap md:justify-end">
                {github && (
                  <LinkButton href={github}>
                    <GitHub class="size-4" />
                    {en ? "Repository" : "Repositorio"}
                  </LinkButton>
                )}
                {link && (
                  <LinkButton href={link}>
                    <Link class="size-4" />
                    {en ? "View project" : "Ver proyecto"}
                  </LinkButton>
                )}
              </div>
            </div>
          </div>

        </article>
      );
    })
  }
</div>
