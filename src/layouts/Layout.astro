---

import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { ClientRouter } from "astro:transitions"

interface Props {
  title: string
  description: string
  ogImage?: string
}

const { description, title, ogImage = "/profile.jpg" } = Astro.props
const siteUrl = "https://alankennedy.dev"
const canonicalURL = `${siteUrl}${Astro.url.pathname}`
const ogImageURL = `${siteUrl}${ogImage}`
const lang = Astro.currentLocale === "en" ? "en" : "es"

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Alan Kennedy",
  "url": siteUrl,
  "jobTitle": "Full Stack Developer",
  "knowsAbout": ["Full Stack Development", "React", "Next.js", "Spring Boot", "TypeScript", "Java", "Python", "Django", "PostgreSQL", "Machine Learning"],
  "sameAs": [
    "https://linkedin.com/in/alankennedyy",
    "https://github.com/kennedyalan"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Corrientes",
    "addressCountry": "AR"
  }
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-MN3YDDW0YM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-MN3YDDW0YM');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content="Alan Kennedy" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Onest:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={`${siteUrl}/`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Alan Kennedy - Portfolio" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_AR"} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <ClientRouter />
  </head>

  <body class="relative text-black dark:text-white">
    <div
      class="absolute top-0 bottom-0 z-[-2] min-h-screen w-full bg-[#fafaf8] dark:bg-[#0d0d10]
      bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(234,179,8,0.09),rgba(250,250,248,0))]
      dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(234,179,8,0.06),rgba(13,13,16,0))]"
    >
    </div>
    <Header />
    <slot />
    <Footer />
    <script>
      // WebMCP: expose site actions to in-browser AI agents
      let controller: AbortController | undefined
      document.addEventListener("astro:page-load", () => {
        const mc = (document as any).modelContext ?? (navigator as any).modelContext
        if (!mc?.registerTool) return
        controller?.abort()
        controller = new AbortController()
        const { signal } = controller
        const sections = [...document.querySelectorAll("section[id], #contacto")].map((el) => el.id)

        mc.registerTool({
          name: "navigate_to_section",
          description: "Scroll the portfolio to a section (experience, projects, education, about me, contact).",
          inputSchema: {
            type: "object",
            properties: { section: { type: "string", enum: sections } },
            required: ["section"],
          },
          execute: async ({ section }: { section: string }) => {
            document.getElementById(section)?.scrollIntoView({ behavior: "smooth" })
            return { scrolledTo: section }
          },
        }, { signal })

        mc.registerTool({
          name: "get_contact_info",
          description: "Get Alan Kennedy's contact details and profile links.",
          inputSchema: { type: "object", properties: {} },
          annotations: { readOnlyHint: true },
          execute: async () => ({
            email: "alaneduardokennedy@gmail.com",
            linkedin: "https://linkedin.com/in/alankennedyy",
            github: "https://github.com/kennedyalan",
          }),
        }, { signal })
      })
    </script>
    <style is:global>
      :root {
        color-scheme: light dark;
      }

      html {
        font-family: 'Onest', system-ui, sans-serif;
        scroll-behavior: smooth;
        font-kerning: normal;
      }

      body {
        color: rgba(17, 17, 17, 0.9);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      @media (prefers-color-scheme: dark) {
        body {
          color: rgba(245, 245,240, 0.9);
        }
      }

      #header-nav {
        animation: blur linear both 0.5s;
        animation-timeline: scroll();
        animation-range: 0 500px;
      }

      @keyframes blur {
        to {
          backdrop-filter: blur(20px);
          border-width: 1px;
          border-color: rgba(0, 0, 0);
          padding: 0.25rem 0.75rem;
          display: flex;
          flex-direction: row;
          align-items: center;
          background-color: rgb(229, 229, 229);
          border-radius: 9999px;
        }
      }

      @media (prefers-color-scheme: dark) {
        @keyframes blur {
          from {
            border: 0px;
          }
          to {
            box-shadow:
              0px 5px 50px -5px rgba(0, 0, 0, 0.1),
              0px 0px 0 1px rgba(0, 0, 0, 0.3);
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(20px);
            border-width: 1px;
            border-color: rgba(0, 0, 0);
            padding-left: 0.75rem;
            padding-right: 0.75rem;
            padding-top: 0.25rem;
            padding-bottom: 0.25rem;
            display: flex;
            flex-direction: row;
            align-items: center;
            background-color: rgba(0, 0, 0, 0.3);
            border-radius: 9999px;
          }
        }
      }
    </style>
  </body>
</html>